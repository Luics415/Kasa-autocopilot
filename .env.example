# AWS Configuration
# Set AWS_MODE to "live" to use AWS Bedrock & Knowledge Base, or "mock" for zero-cost local realistic simulation.
AWS_MODE=mock
AWS_REGION=us-east-1

# Optional live AWS credentials (or use AWS CLI profile / IAM Role)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# Amazon Bedrock Models
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v1

# Amazon Bedrock Knowledge Base (RAG)
BEDROCK_KNOWLEDGE_BASE_ID=arn:aws:bedrock:us-east-1:123456789012:knowledge-base/KASAKB12345
KNOWLEDGE_BASE_DATA_SOURCE_ID=datasource-54321

# S3 Manuals Storage Bucket
S3_MANUALS_BUCKET=kasa-autocopilot-workshop-manuals-us-east-1

# DynamoDB Diagnostic Sessions Table
DYNAMODB_SESSIONS_TABLE=kasa-autocopilot-diagnostic-sessions
